# ELF: LF and UTF-8 at the editor level (.gitattributes covers git only; editors read .editorconfig)
root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown: keep trailing spaces (traditional hard breaks) and session headers; no trimming
[*.md]
trim_trailing_whitespace = false

# PowerShell: UTF-8 with BOM so that PowerShell 5.1 parses CJK text (Generator_Encoding_Rule)
[*.ps1]
charset = utf-8-bom
